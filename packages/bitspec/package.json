{
  "name": "bitspec",
  "version": "0.2.1",
  "description": "Runtime bit-level parser and serializer for binary data described by declarative schemas, compiled to WebAssembly.",
  "type": "module",
  "license": "MIT",
  "author": "Valera Dolgov <sxmebytes@gmail.com>",
  "homepage": "https://github.com/rock-n-rollangel/bitspec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rock-n-rollangel/bitspec.git",
    "directory": "packages/bitspec"
  },
  "bugs": {
    "url": "https://github.com/rock-n-rollangel/bitspec/issues"
  },
  "keywords": [
    "binary",
    "parser",
    "bit",
    "schema",
    "serialization",
    "wasm"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "wasm",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/bitspec-wasm --target web --out-dir ../../packages/bitspec/wasm && rm -f wasm/.gitignore",
    "build:ts": "tsc",
    "build": "npm run build:wasm && npm run build:ts",
    "test": "vitest run",
    "clean": "rm -rf dist wasm"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  }
}
